# ===========================================
# Marvel Chatbot – environment variables
# Copy to .env and fill in your values.
# ===========================================

# --- Required (backend + live app) ---
# MongoDB connection URI (server_prime, phase_1–4, serp_helper, inspect_db)
mongo=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/

# Groq API key (https://console.groq.com/) – chat, keyword extraction, phase_1–4
GROQ_API_KEY=your_groq_api_key_here

# --- Search / scraping (phase_1, phase_4, serp_helper) ---
# SerpAPI key (https://serpapi.com/) – use SERP_API_KEY or SERPAPI_KEY
SERP_API_KEY=your_serpapi_key_here
# SERPAPI_KEY=your_serpapi_key_here

# --- Chat system prompt (server_prime) – optional ---
CHATBOT_CREATOR_NAME=Devang Gandhi
CHATBOT_CREATOR_TITLE=AI engineer
CHATBOT_PROJECT_NAME=Marvel Chatbot
# CHATBOT_EXTRA_RULES=You are still learning and improving every day.
# Section overrides (placeholders: {{CREATOR_NAME}}, {{CREATOR_TITLE}}, {{PROJECT_NAME}}):
# CHATBOT_IDENTITY=You are {{PROJECT_NAME}}, created by {{CREATOR_NAME}}. Expert in Marvel.
# CHATBOT_TASK=Answer using context when relevant; otherwise your knowledge. No implementation jargon.
# CHATBOT_TONE=Concise, friendly, minimal markdown.
# Full custom prompt (use \n for newlines; same placeholders):
# CHATBOT_SYSTEM_PROMPT=You are {{PROJECT_NAME}}.\nCreated by {{CREATOR_NAME}}, {{CREATOR_TITLE}}.\n\nAnswer Marvel questions clearly. If asked who made you, say {{CREATOR_NAME}}, {{CREATOR_TITLE}}.

# --- Optional: cache & limits ---
# Days after which cached external answers are re-fetched (default 30)
# QA_CACHE_TTL_DAYS=30
# SerpAPI free tier: max requests per month (default 100)
# SERPAPI_MONTHLY_LIMIT=100
# SerpAPI cache lifetime in days (default 30)
# SERPAPI_CACHE_DAYS=30

# --- Optional: server port (e.g. phase_4 default 5000; server_prime uses 5001 in code) ---
# PORT=5001

# --- Optional: deployment ---
# RENDER_EXTERNAL_URL=https://your-app.onrender.com/
