services:
  - type: web
    name: marvel-chatbot-backend
    runtime: python
    buildCommand: |
      pip install -r requirements.txt
      playwright install --with-deps
    startCommand: gunicorn server_prime:app --bind 0.0.0.0:$PORT
    envVars:
      - key: PYTHON_VERSION
        value: 3.10
buildCommand: ./postbuild.sh
