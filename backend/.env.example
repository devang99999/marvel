# ===========================================
# Backend – environment variables
# Copy to .env and fill in your values.
# Use different values per environment (dev vs production).
# ===========================================

# ---- Required (all environments) ----
# MongoDB connection URI (server_prime, phase_1–4, serp_helper, inspect_db)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/

# JWT secret for signing auth tokens (required for login/register and protected routes)
JWT_SECRET_KEY=your_secret_key_min_32_chars_for_hmac

# Groq API key (https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# SerpAPI key (https://serpapi.com/)
SERP_API_KEY=your_serpapi_key_here

# ---- Development (local) ----
# PORT=5001
# FLASK_ENV=development
# FRONTEND_URL=http://localhost:5173

# ---- Production (e.g. Render) – set in Render dashboard, not in repo ----
# PORT is set by Render
# FLASK_ENV=production  (or DEBUG=0)
# FRONTEND_URL=https://your-app.netlify.app

# --- Chat system prompt (server_prime) – optional ---
CHATBOT_CREATOR_NAME=Devang Gandhi
CHATBOT_CREATOR_TITLE=AI engineer
CHATBOT_PROJECT_NAME=Marvel Chatbot
# CHATBOT_SYSTEM_PROMPT=You are {{PROJECT_NAME}}.\nCreated by {{CREATOR_NAME}}.

# --- Optional ---
# QA_CACHE_TTL_DAYS=30
# SERPAPI_MONTHLY_LIMIT=100
